{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "outDir": "_build",
        "moduleResolution": "node",
        "sourceMap": false,
        "declaration": true,
        "emitDecoratorMetadata": false,
        "experimentalDecorators": false,
        "lib": ["esnext", "dom"],
        "noImplicitAny": true,
        "allowJs": true,
        "rootDir": ".",
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": ["./app.ts"]

}